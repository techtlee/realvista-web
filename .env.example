# Where a submitted lead goes: the CRM's intake endpoint, e.g.
# https://cms.example.cz/api/intake. Called from the server only.
#
# Leave unset in development: submissions are logged to the terminal and the
# form reports success, so the whole page works with no backend at all.
# In production an unset value makes submissions fail loudly (503).
LEAD_ENDPOINT=

# Shared preview without a backend (e.g. a Vercel preview to show people):
# submissions succeed without being sent, and a banner says so. Never on the
# real production deployment.
# NEXT_PUBLIC_DEMO_MODE=1
